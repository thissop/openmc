# Build artifacts / caches (source + results are tracked; binaries are not)
build/
__pycache__/
*.pyc
*.so
*.o
run_*/
.pytest_cache/
# Reference papers kept locally for reference, not committed (large/copyright)
*.pdf

# Data bundles for moving between instances
*.tgz

# LaTeX build artifacts (slide .tex is tracked; PDF handled by *.pdf above)
*.aux
*.nav
*.snm
*.toc
*.out
*.log

# Figures ARE tracked on this branch: override OpenMC's repo-wide *.png ignore
!figs/
!figs/*.png
data/*_s[0-9]*.meta
data/*_s[0-9]*.bin
data/*_geom/

# ...track the capstone paper package + teaching deck despite the *.pdf/*.png ignores above
!paper/figures/*.pdf
!paper/figures/*.png
!paper/manuscript/*.pdf
!paper/data/**
!teaching_materials/*.pdf

# Large binary reactor data — regenerated by scripts (wout_to_fluxmap.py, QUASR loader);
# tracked code/docs stay, multi-MB binaries do not. Tiny paired *.meta text is kept for provenance.
*.nc
*.h5m
*.h5
*.npz
*.gz
data/quasr/
data/*fluxmap*.bin
data/*_reactor_fluxmap.*
data/qa_*fluxmap*
data/qh_*fluxmap*
**/data/processed/*.npz
talk/figs/*.jpg
quasr59509_conformal_flux.npz
